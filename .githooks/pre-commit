#!/usr/bin/env bash
# PhotoTux pre-commit: rustfmt + clippy only (fast path via scripts/check-rust.sh).
# Full gate with rust-doctor: CHECK_RUST_FULL=1 ./scripts/check-rust.sh
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -z "$ROOT" ]]; then
  echo "error: not a git repository" >&2
  exit 1
fi

exec "$ROOT/scripts/check-rust.sh"
