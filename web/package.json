{
  "name": "@phototux/web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:landing": "pnpm --filter @phototux/landing dev",
    "dev:docs": "pnpm --filter @phototux/docs dev",
    "build": "pnpm --recursive --filter \"./landing\" --filter \"./docs\" build",
    "build:landing": "pnpm --filter @phototux/landing build",
    "build:docs": "pnpm --filter @phototux/docs build",
    "preview:landing": "pnpm --filter @phototux/landing preview",
    "preview:docs": "pnpm --filter @phototux/docs preview",
    "check": "pnpm --recursive --filter \"./landing\" --filter \"./docs\" exec astro check"
  }
}
